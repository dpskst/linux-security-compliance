#!/bin/bash

REPORT="$(dirname "$0")/../reports/security-report.txt"

PASS=0
FAIL=0

echo "========================================" | tee "$REPORT"
echo " Linux Security Compliance Report" | tee -a "$REPORT"
echo "========================================" | tee -a "$REPORT"
echo "" | tee -a "$REPORT"

check_result() {
    local ID="$1"
    local NAME="$2"
    local RESULT="$3"

    if [ "$RESULT" = "PASS" ]; then
        echo "[PASS] $ID - $NAME" | tee -a "$REPORT"
        PASS=$((PASS + 1))
    else
        echo "[FAIL] $ID - $NAME" | tee -a "$REPORT"
        FAIL=$((FAIL + 1))
    fi
}

# U-01 Root 원격 로그인 제한
ROOT_LOGIN=$(sshd -T 2>/dev/null | grep "^permitrootlogin ")

if echo "$ROOT_LOGIN" | grep -qi "no"; then
    check_result "U-01" "Root 원격 로그인 제한" "PASS"
else
    check_result "U-01" "Root 원격 로그인 제한" "FAIL"
fi

# U-02 SSH 설정 확인
if command -v sshd >/dev/null 2>&1; then
    check_result "U-02" "SSH 설정 확인" "PASS"
else
    check_result "U-02" "SSH 설정 확인" "FAIL"
fi

# U-03 패스워드 최대 사용 기간
PASS_MAX=$(grep "^PASS_MAX_DAYS" /etc/login.defs | awk '{print $2}')

if [ -n "$PASS_MAX" ] && [ "$PASS_MAX" -le 90 ]; then
    check_result "U-03" "패스워드 최대 사용 기간" "PASS"
else
    check_result "U-03" "패스워드 최대 사용 기간" "FAIL"
fi

# U-04 Firewall 활성화
if systemctl is-active --quiet firewalld; then
    check_result "U-04" "Firewall 활성화" "PASS"
else
    check_result "U-04" "Firewall 활성화" "FAIL"
fi

# U-05 SSH 서비스 활성화
if systemctl is-enabled --quiet sshd 2>/dev/null; then
    check_result "U-05" "SSH 서비스 활성화 상태" "PASS"
else
    check_result "U-05" "SSH 서비스 활성화 상태" "FAIL"
fi

# U-06 불필요한 계정 점검
SYSTEM_ACCOUNTS=$(awk -F: '$3 >= 1000 && $3 < 65534 {print $1}' /etc/passwd)

if [ -n "$SYSTEM_ACCOUNTS" ]; then
    check_result "U-06" "일반 사용자 계정 확인" "PASS"
else
    check_result "U-06" "일반 사용자 계정 확인" "FAIL"
fi

# U-07 UID 0 계정 점검
UID_ZERO=$(awk -F: '$3 == 0 {print $1}' /etc/passwd | grep -v "^root$")

if [ -z "$UID_ZERO" ]; then
    check_result "U-07" "추가 UID 0 계정 존재 여부" "PASS"
else
    check_result "U-07" "추가 UID 0 계정 존재 여부" "FAIL"
fi

# U-08 /etc/passwd 파일 권한
PASSWD_PERM=$(stat -c "%a" /etc/passwd)

if [ "$PASSWD_PERM" -le 644 ]; then
    check_result "U-08" "/etc/passwd 파일 권한" "PASS"
else
    check_result "U-08" "/etc/passwd 파일 권한" "FAIL"
fi

# U-09 /etc/shadow 파일 권한
SHADOW_PERM=$(stat -c "%a" /etc/shadow)

if [ "$SHADOW_PERM" -le 640 ]; then
    check_result "U-09" "/etc/shadow 파일 권한" "PASS"
else
    check_result "U-09" "/etc/shadow 파일 권한" "FAIL"
fi

# U-10 SSH 서비스 상태
if systemctl is-active --quiet sshd; then
    check_result "U-10" "SSH 서비스 실행 상태" "PASS"
else
    check_result "U-10" "SSH 서비스 실행 상태" "FAIL"
fi

# U-11 SSH 포트 확인
SSH_PORT=$(sshd -T 2>/dev/null | awk '$1 == "port" {print $2; exit}')

if [ "$SSH_PORT" = "22" ]; then
    check_result "U-11" "SSH 기본 포트 사용 여부" "PASS"
else
    check_result "U-11" "SSH 기본 포트 사용 여부" "FAIL"
fi

# U-12 PasswordAuthentication 설정
PASSWORD_AUTH=$(sshd -T 2>/dev/null | awk '$1 == "passwordauthentication" {print $2}')

if [ "$PASSWORD_AUTH" = "no" ]; then
    check_result "U-12" "SSH PasswordAuthentication 비활성화" "PASS"
else
    check_result "U-12" "SSH PasswordAuthentication 비활성화" "FAIL"
fi

# U-13 PermitEmptyPasswords 설정
EMPTY_PASSWORD=$(sshd -T 2>/dev/null | awk '$1 == "permitemptypasswords" {print $2}')

if [ "$EMPTY_PASSWORD" = "no" ]; then
    check_result "U-13" "SSH 빈 패스워드 로그인 제한" "PASS"
else
    check_result "U-13" "SSH 빈 패스워드 로그인 제한" "FAIL"
fi

# U-14 X11Forwarding 설정
X11_FORWARD=$(sshd -T 2>/dev/null | awk '$1 == "x11forwarding" {print $2}')

if [ "$X11_FORWARD" = "no" ]; then
    check_result "U-14" "SSH X11Forwarding 비활성화" "PASS"
else
    check_result "U-14" "SSH X11Forwarding 비활성화" "FAIL"
fi

# U-15 Firewall 상태
if systemctl is-active --quiet firewalld; then
    check_result "U-15" "Firewall 활성화 상태" "PASS"
else
    check_result "U-15" "Firewall 활성화 상태" "FAIL"
fi

# U-16 SELinux 상태
SELINUX_STATUS=$(getenforce 2>/dev/null)

if [ "$SELINUX_STATUS" = "Enforcing" ]; then
    check_result "U-16" "SELinux 활성화 상태" "PASS"
else
    check_result "U-16" "SELinux 활성화 상태" "FAIL"
fi

# U-17 auditd 서비스 상태
if systemctl is-active --quiet auditd; then
    check_result "U-17" "auditd 서비스 실행 상태" "PASS"
else
    check_result "U-17" "auditd 서비스 실행 상태" "FAIL"
fi

# U-18 rsyslog 서비스 상태
if systemctl is-active --quiet rsyslog; then
    check_result "U-18" "rsyslog 서비스 실행 상태" "PASS"
else
    check_result "U-18" "rsyslog 서비스 실행 상태" "FAIL"
fi

# U-19 chronyd 서비스 상태
if systemctl is-active --quiet chronyd; then
    check_result "U-19" "시간 동기화 서비스 상태" "PASS"
else
    check_result "U-19" "시간 동기화 서비스 상태" "FAIL"
fi

# U-20 불필요한 서비스 확인
RUNNING_SERVICES=$(systemctl list-units --type=service --state=running --no-legend 2>/dev/null | wc -l)

if [ "$RUNNING_SERVICES" -gt 0 ]; then
    check_result "U-20" "실행 중 서비스 확인" "PASS"
else
    check_result "U-20" "실행 중 서비스 확인" "FAIL"
fi

# U-21 /etc/passwd 파일 소유자 및 권한
PASSWD_INFO=$(stat -c "%a %U %G" /etc/passwd 2>/dev/null)

if [ "$PASSWD_INFO" = "644 root root" ]; then
    check_result "U-21" "/etc/passwd 소유자 및 권한" "PASS"
else
    check_result "U-21" "/etc/passwd 소유자 및 권한" "FAIL"
fi

# U-22 /etc/shadow 파일 소유자 및 권한
SHADOW_INFO=$(stat -c "%a %U %G" /etc/shadow 2>/dev/null)

if [ "$SHADOW_INFO" = "640 root root" ] || [ "$SHADOW_INFO" = "000 root root" ]; then
    check_result "U-22" "/etc/shadow 소유자 및 권한" "PASS"
else
    check_result "U-22" "/etc/shadow 소유자 및 권한" "FAIL"
fi

# U-23 /etc/group 파일 권한
GROUP_INFO=$(stat -c "%a %U %G" /etc/group 2>/dev/null)

if [ "$GROUP_INFO" = "644 root root" ]; then
    check_result "U-23" "/etc/group 소유자 및 권한" "PASS"
else
    check_result "U-23" "/etc/group 소유자 및 권한" "FAIL"
fi

# U-24 SSH 설정 파일 권한
SSHD_INFO=$(stat -c "%a %U %G" /etc/ssh/sshd_config 2>/dev/null)

if [ "$SSHD_INFO" = "600 root root" ] || [ "$SSHD_INFO" = "644 root root" ]; then
    check_result "U-24" "SSH 설정 파일 권한" "PASS"
else
    check_result "U-24" "SSH 설정 파일 권한" "FAIL"
fi

# U-25 /etc/hosts 파일 권한
HOSTS_INFO=$(stat -c "%a %U %G" /etc/hosts 2>/dev/null)

if [ "$HOSTS_INFO" = "644 root root" ]; then
    check_result "U-25" "/etc/hosts 파일 권한" "PASS"
else
    check_result "U-25" "/etc/hosts 파일 권한" "FAIL"
fi

# U-26 audit 로그 존재 여부
if [ -f /var/log/audit/audit.log ]; then
    check_result "U-26" "Audit 로그 존재 여부" "PASS"
else
    check_result "U-26" "Audit 로그 존재 여부" "FAIL"
fi

# U-27 SSH 로그인 실패 기록 확인
if command -v journalctl >/dev/null 2>&1; then
    FAILED_LOGINS=$(journalctl -u sshd --since "24 hours ago" 2>/dev/null | grep -ciE "failed|failure")

    if [ "$FAILED_LOGINS" -ge 0 ]; then
        check_result "U-27" "SSH 로그인 실패 로그 확인" "PASS"
    else
        check_result "U-27" "SSH 로그인 실패 로그 확인" "FAIL"
    fi
else
    check_result "U-27" "SSH 로그인 실패 로그 확인" "FAIL"
fi

# U-28 최근 로그인 기록 확인
if command -v last >/dev/null 2>&1; then
    LAST_LOGIN=$(last -n 1 2>/dev/null | head -1)

    if [ -n "$LAST_LOGIN" ]; then
        check_result "U-28" "최근 로그인 기록 확인" "PASS"
    else
        check_result "U-28" "최근 로그인 기록 확인" "FAIL"
    fi
else
    check_result "U-28" "최근 로그인 기록 확인" "FAIL"
fi

# U-29 디스크 사용량
DISK_USAGE=$(df / | awk 'NR==2 {gsub("%","",$5); print $5}')

if [ -n "$DISK_USAGE" ] && [ "$DISK_USAGE" -lt 90 ]; then
    check_result "U-29" "Root 파일시스템 사용량" "PASS"
else
    check_result "U-29" "Root 파일시스템 사용량" "FAIL"
fi

# U-30 주요 보안 서비스 상태
SECURITY_SERVICE_OK=0

for SERVICE in auditd rsyslog sshd; do
    if systemctl is-active --quiet "$SERVICE"; then
        SECURITY_SERVICE_OK=$((SECURITY_SERVICE_OK + 1))
    fi
done

if [ "$SECURITY_SERVICE_OK" -eq 3 ]; then
    check_result "U-30" "주요 보안 서비스 실행 상태" "PASS"
else
    check_result "U-30" "주요 보안 서비스 실행 상태" "FAIL"
fi

echo "" | tee -a "$REPORT"
echo "========================================" | tee -a "$REPORT"
echo "PASS : $PASS" | tee -a "$REPORT"
echo "FAIL : $FAIL" | tee -a "$REPORT"
echo "========================================" | tee -a "$REPORT"
